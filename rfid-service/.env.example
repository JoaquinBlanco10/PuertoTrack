# Broker local de desarrollo
RFID_MQTT_HOST=localhost
RFID_MQTT_PORT=1883
RFID_MQTT_TOPIC=puertotrack/rfid/detecciones
RFID_MQTT_IDENTIFICATIONS_TOPIC=puertotrack/rfid/identificaciones.v1
RFID_MQTT_CLIENT_ID=puertotrack-rfid-consumer

# Backend operacional. No usar una URL de base de datos aquí.
PUERTOTRACK_API_URL=http://localhost:8000

# Debe coincidir con RFID_INTERNAL_API_KEY configurada en el backend.
# Generar un valor aleatorio de al menos 32 bytes; no versionarlo.
RFID_INTERNAL_API_KEY=

# Límites locales del prototipo
RFID_MAX_PAYLOAD_BYTES=4096
RFID_DEDUP_TTL_SECONDS=600
RFID_MAX_PROCESSING_RECORDS=500
RFID_BACKEND_TIMEOUT_SECONDS=3
