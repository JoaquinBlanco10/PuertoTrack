ACCESS_MQTT_HOST=localhost
ACCESS_MQTT_PORT=1883
ACCESS_MQTT_INPUT_TOPIC=puertotrack/rfid/identificaciones.v1
ACCESS_MQTT_OUTPUT_TOPIC=puertotrack/accesos/resultados.v1
ACCESS_MQTT_CLIENT_ID=puertotrack-access-consumer

PUERTOTRACK_API_URL=http://127.0.0.1:8000
ACCESS_INTERNAL_API_KEY=

ACCESS_MAX_PAYLOAD_BYTES=4096
ACCESS_DEDUP_TTL_SECONDS=600
ACCESS_DECISION_TTL_SECONDS=3600
ACCESS_MAX_DECISIONS=500
ACCESS_BACKEND_TIMEOUT_SECONDS=3
