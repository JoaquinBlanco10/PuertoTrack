# Conexión existente de PostgreSQL
DATABASE_URL=

# Genera un valor aleatorio largo y diferente para cada entorno
JWT_SECRET_KEY=

# Duración del token de acceso en minutos (opcional; valor por defecto: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen local autorizado para el frontend de Vite (sin barra final)
FRONTEND_ORIGIN=http://localhost:5173

# Clave compartida solo con el microservicio RFID (mínimo 32 bytes aleatorios)
RFID_INTERNAL_API_KEY=

# Clave independiente compartida solo con el microservicio de accesos
ACCESS_INTERNAL_API_KEY=

# API local del microservicio de accesos para el proxy supervisor
ACCESS_SERVICE_URL=http://127.0.0.1:8200
